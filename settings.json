{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet[1m]",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/acontext_bridge.sh SessionStart",
            "timeout": 12,
            "statusMessage": "Acontext: starting session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/acontext_bridge.sh UserPromptSubmit",
            "timeout": 12,
            "statusMessage": "Acontext: loading context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/security_gate.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "{Read,Write,Edit}",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/security_gate.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/acontext_bridge.sh PreToolUse",
            "timeout": 5,
            "statusMessage": "Acontext: checking file memory"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "{Read,Write,Edit,Bash}",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/acontext_bridge.sh PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/acontext_bridge.sh SubagentStart",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/acontext_bridge.sh Stop",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/learning_hook.sh",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-powerline --theme=tokyo-night --style=powerline"
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "ralph-wiggum@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "teammateMode": "in-process"
}
